diff --git a/libretro.cpp b/libretro.cpp
index aba2bc2..7566cd4 100755
--- a/libretro.cpp
+++ b/libretro.cpp
@@ -202,6 +202,124 @@ static void update_config_variables()
 }
 
 
+// =============================================================================
+//      PASSING THE FRONTEND LOCALE TO CARTRIDGES
+// =============================================================================
+
+
+// This optional record is a producer convention rather than Vircon32 hardware.
+// Cartridges that do not recognize it simply treat these words as ordinary RAM.
+static const uint32_t BootLocaleMagic = 0x4C323356u;  // "V32L"
+static const uint32_t BootLocaleVersion = 1;
+static const uint32_t BootLocaleRAMWord = 0;
+static const uint32_t BootLocaleWordCount = 5;
+static V32::V32Word BootLocaleWords[ BootLocaleWordCount ];
+static bool BootLocaleAvailable = false;
+
+// Vircon32 currently ships the libretro header through Hungarian (31).
+// Gamejin implements the five language values subsequently assigned by
+// libretro, so retain their stable numeric API values locally.
+static const unsigned RetroLanguageBelarusian = 32;
+static const unsigned RetroLanguageGalician = 33;
+static const unsigned RetroLanguageNorwegian = 34;
+static const unsigned RetroLanguageIrish = 35;
+static const unsigned RetroLanguageThai = 36;
+
+// Pack up to four ASCII characters in Vircon32's little-endian word format.
+static uint32_t PackLocaleCode( const char* Code )
+{
+    uint32_t Packed = 0;
+
+    for( int Index = 0; Code[ Index ] && Code[ Index ] != '-' && Index < 4; Index++ )
+      Packed |= (uint32_t)(uint8_t)Code[ Index ] << (8 * Index);
+
+    return Packed;
+}
+
+// Translate every libretro language to an ISO-style locale tag. The optional
+// suffix is stored separately as a territory or variant word.
+static bool GetFrontendLocaleTags
+(
+    unsigned FrontendLanguage, uint32_t& Language, uint32_t& Territory
+)
+{
+    const char* Tag = nullptr;
+    Territory = 0;
+
+    switch( FrontendLanguage )
+    {
+        case RETRO_LANGUAGE_ENGLISH:             Tag = "en"; break;
+        case RETRO_LANGUAGE_JAPANESE:            Tag = "ja"; break;
+        case RETRO_LANGUAGE_FRENCH:              Tag = "fr"; break;
+        case RETRO_LANGUAGE_SPANISH:             Tag = "es"; break;
+        case RETRO_LANGUAGE_GERMAN:              Tag = "de"; break;
+        case RETRO_LANGUAGE_ITALIAN:             Tag = "it"; break;
+        case RETRO_LANGUAGE_DUTCH:               Tag = "nl"; break;
+        case RETRO_LANGUAGE_PORTUGUESE_BRAZIL:   Tag = "pt-BR"; break;
+        case RETRO_LANGUAGE_PORTUGUESE_PORTUGAL: Tag = "pt-PT"; break;
+        case RETRO_LANGUAGE_RUSSIAN:             Tag = "ru"; break;
+        case RETRO_LANGUAGE_KOREAN:              Tag = "ko"; break;
+        case RETRO_LANGUAGE_CHINESE_TRADITIONAL: Tag = "zh-TW"; break;
+        case RETRO_LANGUAGE_CHINESE_SIMPLIFIED:  Tag = "zh-CN"; break;
+        case RETRO_LANGUAGE_ESPERANTO:           Tag = "eo"; break;
+        case RETRO_LANGUAGE_POLISH:              Tag = "pl"; break;
+        case RETRO_LANGUAGE_VIETNAMESE:          Tag = "vi"; break;
+        case RETRO_LANGUAGE_ARABIC:              Tag = "ar"; break;
+        case RETRO_LANGUAGE_GREEK:               Tag = "el"; break;
+        case RETRO_LANGUAGE_TURKISH:             Tag = "tr"; break;
+        case RETRO_LANGUAGE_SLOVAK:              Tag = "sk"; break;
+        case RETRO_LANGUAGE_PERSIAN:             Tag = "fa"; break;
+        case RETRO_LANGUAGE_HEBREW:              Tag = "he"; break;
+        case RETRO_LANGUAGE_ASTURIAN:            Tag = "ast"; break;
+        case RETRO_LANGUAGE_FINNISH:             Tag = "fi"; break;
+        case RETRO_LANGUAGE_INDONESIAN:          Tag = "id"; break;
+        case RETRO_LANGUAGE_SWEDISH:             Tag = "sv"; break;
+        case RETRO_LANGUAGE_UKRAINIAN:           Tag = "uk"; break;
+        case RETRO_LANGUAGE_CZECH:               Tag = "cs"; break;
+        case RETRO_LANGUAGE_CATALAN_VALENCIA:    Tag = "ca-val"; break;
+        case RETRO_LANGUAGE_CATALAN:             Tag = "ca"; break;
+        case RETRO_LANGUAGE_BRITISH_ENGLISH:     Tag = "en-GB"; break;
+        case RETRO_LANGUAGE_HUNGARIAN:           Tag = "hu"; break;
+        case RetroLanguageBelarusian:            Tag = "be"; break;
+        case RetroLanguageGalician:              Tag = "gl"; break;
+        case RetroLanguageNorwegian:             Tag = "no"; break;
+        case RetroLanguageIrish:                 Tag = "ga"; break;
+        case RetroLanguageThai:                  Tag = "th"; break;
+        default:
+          return false;
+    }
+
+    Language = PackLocaleCode( Tag );
+
+    const char* Suffix = strchr( Tag, '-' );
+    if( Suffix )
+      Territory = PackLocaleCode( Suffix + 1 );
+
+    return true;
+}
+
+// Build the transient boot record from the frontend's current language.
+static void UpdateFrontendLocale()
+{
+    unsigned FrontendLanguage = RETRO_LANGUAGE_ENGLISH;
+    uint32_t Language;
+    uint32_t Territory;
+    BootLocaleAvailable = false;
+
+    if( !environ_cb( RETRO_ENVIRONMENT_GET_LANGUAGE, &FrontendLanguage ) ||
+        !GetFrontendLocaleTags( FrontendLanguage, Language, Territory ) )
+      return;
+
+    BootLocaleWords[ 0 ].AsBinary = BootLocaleMagic;
+    BootLocaleWords[ 1 ].AsBinary = BootLocaleVersion;
+    BootLocaleWords[ 2 ].AsBinary = Language;
+    BootLocaleWords[ 3 ].AsBinary = Territory;
+    BootLocaleWords[ 4 ].AsBinary =
+        BootLocaleMagic ^ BootLocaleVersion ^ Language ^ Territory;
+    BootLocaleAvailable = true;
+}
+
+
 // =============================================================================
 //      SETTING UP THE CORE ENVIRONMENT
 // =============================================================================
@@ -541,6 +659,15 @@ void context_reset()
         if( !LoadedCartridgePath.empty() )
         {
             Console.LoadCartridge( LoadedCartridgePath );
+
+            // The console applies this after the BIOS and immediately before
+            // the cartridge's first instruction, so the BIOS cannot erase it.
+            Console.SetCartridgeStartupRAM
+            (
+                BootLocaleRAMWord,
+                BootLocaleAvailable? BootLocaleWords : nullptr,
+                BootLocaleAvailable? BootLocaleWordCount : 0
+            );
             
             // also load the corresponding memory card if existing
             if( FileExists( LoadedMemoryCardPath ) )
@@ -699,6 +826,7 @@ bool retro_load_game( const struct retro_game_info *info )
     
     // before loading ensure that config variables are updated
     update_config_variables();
+    UpdateFrontendLocale();
     
     // define the quircks of our serialization
     uint64_t SerializationQuirks =
