From 5a9a26704dc9ba2f88c5897f2f32ed0abedcb007 Mon Sep 17 00:00:00 2001
From: Fernando Carmona Varo <ferkiwi@gmail.com>
Date: Tue, 27 Oct 2026 22:08:18 +0100
Subject: [PATCH] Pass frontend language to cartridges at startup

Use the libretro frontend language setting to build an optional transient
startup-locale record in RAM before the cartridge executes. Keep the
injection mechanism generic so cartridges may opt into the convention.

Translate every language defined by libretro to an ISO-style tag. The
two 32-bit tag fields carry up to four ASCII characters each, allowing
Asturian and the Valencian variant to be represented alongside locale
suffixes such as en-GB, pt-BR, zh-TW and zh-CN.

Vircon32 currently ships an older libretro header, so the patch also
defines the stable numeric values for the five newer language constants.

---

diff --git a/ConsoleLogic/V32Console.cpp b/ConsoleLogic/V32Console.cpp
index 8e5dc5a..e22699a 100755
--- a/ConsoleLogic/V32Console.cpp
+++ b/ConsoleLogic/V32Console.cpp
@@ -58,6 +58,8 @@ namespace V32
         
         // set initial state
         PowerIsOn = false;
+        CartridgeStartupRAMPending = false;
+        CartridgeStartupRAMFirstWord = 0;
         
         // initial loads are 0
         LastCPULoads[ 0 ] = LastCPULoads[ 1 ] = 0;
@@ -120,12 +122,32 @@ namespace V32
         
         // now reset the console itself
         RAM.ClearContents();
+        CartridgeStartupRAMPending = HasCartridge() && !CartridgeStartupRAMWords.empty();
         
         // loads become 0 on a reset
         LastCPULoads[ 0 ] = LastCPULoads[ 1 ] = 0;
         LastGPULoads[ 0 ] = LastGPULoads[ 1 ] = 0;
     }
     
+    // -----------------------------------------------------------------------------
+
+    // Configure optional words supplied by the host immediately before cartridge
+    // execution. An empty payload disables the facility.
+    void V32Console::SetCartridgeStartupRAM
+    (
+        uint32_t FirstWord, const V32Word* Words, uint32_t WordCount
+    )
+    {
+        CartridgeStartupRAMFirstWord = FirstWord;
+        CartridgeStartupRAMWords.clear();
+
+        if( Words && WordCount )
+          CartridgeStartupRAMWords.assign( Words, Words + WordCount );
+
+        CartridgeStartupRAMPending =
+            HasCartridge() && !CartridgeStartupRAMWords.empty();
+    }
+
     // -----------------------------------------------------------------------------
     
     // if a device can't run at 60 fps, some frames may be
@@ -162,6 +184,38 @@ namespace V32
                 // end loop early when CPU is set to wait
                 if( CPU.Waiting || CPU.Halted )
                   break;
+
+                // Let a host provide transient startup information after the BIOS
+                // has finished, but before the cartridge executes any instruction.
+                if( CartridgeStartupRAMPending )
+                {
+                    uint32_t InstructionAddress = CPU.InstructionPointer.AsBinary;
+                    uint32_t CartridgeFirst = Constants::CartridgeProgramROMFirstAddress;
+                    uint32_t CartridgeEnd =
+                        CartridgeFirst + CartridgeController.MemorySize;
+
+                    if( InstructionAddress >= CartridgeFirst &&
+                        InstructionAddress < CartridgeEnd )
+                    {
+                        uint32_t AvailableWords = 0;
+
+                        if( CartridgeStartupRAMFirstWord < (uint32_t)RAM.MemorySize )
+                          AvailableWords =
+                              RAM.MemorySize - CartridgeStartupRAMFirstWord;
+
+                        uint32_t CopiedWords = min
+                        (
+                            (uint32_t)CartridgeStartupRAMWords.size(),
+                            AvailableWords
+                        );
+
+                        for( uint32_t Word = 0; Word < CopiedWords; Word++ )
+                          RAM.Memory[ CartridgeStartupRAMFirstWord + Word ] =
+                              CartridgeStartupRAMWords[ Word ];
+
+                        CartridgeStartupRAMPending = false;
+                    }
+                }
                 
                 // only these components need to
                 // be notified of each CPU cycle
