		"systems": ["Nintendo DS"]
	},
	"mesen": {
		"name": "Mesen",
		"repository": "Mesen",
		"directory": "Libretro",
		"systems": ["NES"]
	},
	"snes9x": {
		"name": "Snes9x",
		"directory": "libretro",
		"systems": ["SNES"]
	},
	"genesis": {
		"name": "Genesis Plus GX",
		"repository": "Genesis-Plus-GX",
		"makefile": "Makefile.libretro",
		"systems": ["Master System", "Mega Drive"]
	},
	"pcsx": {
		"name": "PCSX-ReARMed",
		"repository": "pcsx_rearmed",
		"makefile": "Makefile.libretro",
		"stripEmccSettings": true,
		"buildFlags": ["USE_MINIZ=1", "BUILTIN_GPU=peops"],
		"systems": ["PlayStation"]
	},
	"retro8": {
		"name": "Retro8",
		"repository": "retro8",
		"preinclude": "../wasi-compat.h",
