		"systems": ["PICO-8"]
	},
	"tic80": {
		"name": "TIC-80",
		"repository": "TIC-80",
		"directory": "core",
		"cmake": true,
		"defineEmscripten": false,
		"cFlags": "-DMA_3DS",
		"systems": ["TIC-80"],
		"linkArchives": [
			"tic80-libs/libtic80core.a",
			"tic80-libs/libpng.a",
			"tic80-libs/libzlib.a",
			"tic80-libs/libgiflib.a",
			"tic80-libs/libblipbuf.a"
		]
	}
